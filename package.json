{
  "name": "jarvis-local",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "main": "electron-main.mjs",
  "scripts": {
    "start": "node server.mjs",
    "desktop": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "setup": "node scripts/setup.mjs",
    "predist": "npm run setup",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1"
  },
  "devDependencies": {
    "electron": "^40.10.6",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.temuulenbuuveibaatar.jarvissphere",
    "productName": "JARVIS Sphere",
    "files": [
      "public/**/*",
      "server.mjs",
      "hermes_bridge.py",
      "computer_action.py",
      "desktop_control.py",
      "transcribe_audio.py",
      "electron-main.mjs",
      "package.json"
    ],
    "asarUnpack": [
      "*.py"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    }
  }
}
