{
  "name": "jarvis-local",
  "version": "1.1.5",
  "private": true,
  "type": "module",
  "main": "electron-main.mjs",
  "scripts": {
    "test": "node --test *.test.mjs",
    "dist": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@mediapipe/tasks-vision": "1.0.1"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.jarvis.local",
    "productName": "JARVIS Sphere",
    "artifactName": "JARVIS-Sphere-Setup-${version}.${ext}",
    "asar": true,
    "asarUnpack": [
      "*.py"
    ],
    "files": [
      "**/*",
      "!release{,/**}",
      "!.agents{,/**}",
      "!.claude{,/**}",
      "!.claude-flow{,/**}",
      "!.codex{,/**}",
      "!.playwright-cli{,/**}",
      "!.swarm{,/**}",
      "!*.test.mjs"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "JARVIS-Sphere-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
